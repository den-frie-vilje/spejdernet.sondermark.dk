# HumHub 1.18.3. Bump both Dockerfiles together; the branch decides the environment
# (staging builds from the staging branch, production from main).
# The digest is the manifest-list digest Docker Hub shows for the tag.
FROM docker.io/jeremyvies/humhub:1.18.3-phponly@sha256:09d1b0f40003a4f4de59dc4dc5dcbcf78801ec8b1aa9dca7ecabd257e2080bf0
# Alpine security updates at build time, so a PHP or nginx fix ships as soon as
# Alpine has it, without waiting for the upstream image to be rebuilt. Re-run
# the workflow by hand (workflow_dispatch) to pick up a new fix.
RUN apk --no-cache upgrade
