# Stack env for staging. Copy to
# /volume1/docker/spejdernet.sondermark.dk/staging/staging.env (0640 root:docker).
# Loopback port the DSM reverse-proxy vhost for spejdernet-sondermark-dk.stage.denfrievilje.dk points at.
HUMHUB_PORT=2081
# Loopback port of the mail catcher's web UI (every mail staging sends).
MAILCATCHER_PORT=2082
DATA_DIR=/volume1/docker/spejdernet.sondermark.dk/staging/data
# Any value: tools/refresh-staging.sh recreates the staging database with it.
DB_ROOT_PASSWORD=
DB_USER=root
DB_PASSWORD=
