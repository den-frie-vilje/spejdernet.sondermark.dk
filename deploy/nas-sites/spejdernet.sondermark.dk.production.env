# nas-sites agent config for production of spejdernet.sondermark.dk. What tools/bootstrap-site.sh
# writes; kept here so the values are on record. Lives at
# /volume1/docker/nas-sites/sites.d/spejdernet.sondermark.dk.production.env (0640 root:docker).
DOMAIN="spejdernet.sondermark.dk"
ENV_NAME="production"
REPO="den-frie-vilje/spejdernet.sondermark.dk"
BRANCH="main"
COMPOSE_FILE_REL="deploy/compose.production.yml"
SITE_SERVICE="humhub"
CF_API_TOKEN=""
CF_ZONE_IDS=""
