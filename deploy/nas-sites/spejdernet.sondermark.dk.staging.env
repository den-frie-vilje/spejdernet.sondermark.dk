# nas-sites agent config for staging of spejdernet.sondermark.dk. What tools/bootstrap-site.sh
# writes; kept here so the values are on record. Lives at
# /volume1/docker/nas-sites/sites.d/spejdernet.sondermark.dk.staging.env (0640 root:docker).
DOMAIN="spejdernet.sondermark.dk"
ENV_NAME="staging"
REPO="den-frie-vilje/spejdernet.sondermark.dk"
BRANCH="staging"
COMPOSE_FILE_REL="deploy/compose.staging.yml"
SITE_SERVICE="humhub"
CF_API_TOKEN=""
CF_ZONE_IDS=""
